{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/frontend/images/$1"
    },
    {
      "source": "/vite.svg",
      "destination": "/frontend/vite.svg"
    },
    {
      "source": "/about",
      "destination": "/frontend/src/pages/AboutPage.jsx"
    },
    {
      "source": "/expos",
      "destination": "/frontend/src/pages/ExposPage.jsx"
    },
    {
      "source": "/team",
      "destination": "/frontend/src/pages/TeamPage.jsx"
    },
    {
      "source": "/hackathon",
      "destination": "/frontend/src/pages/HackathonsPage.jsx"
    },
    {
      "source": "/programs",
      "destination": "/frontend/src/pages/ProgramsPage.jsx"
    },
    {
      "source": "/projects",
      "destination": "/frontend/src/pages/ProjectsPage.jsx"
    },
    {
      "source": "/contact",
      "destination": "/frontend/src/pages/ContactPage.jsx"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}